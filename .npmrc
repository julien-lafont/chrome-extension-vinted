; Réplique le layout de node_modules attendu par les outils qui résolvent par
; chemin (esbuild, tsx). `isolated` est le défaut de pnpm ; on l'écrit pour que
; le comportement ne dépende pas de la version installée.
node-linker=isolated

; Le graphe de peers d'ESLint/typescript-eslint est bruyant sans être cassé :
; on installe les peers manquants plutôt que d'échouer à l'install.
auto-install-peers=true
strict-peer-dependencies=false
