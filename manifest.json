{
  "manifest_version": 3,
  "name": "Vinted Favoris",
  "version": "0.1.0",
  "description": "Enregistre tes articles Vinted préférés en local et retrouve-les dans un panneau latéral.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.vinted.fr/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Ouvrir mes favoris Vinted"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["src/content/offer-agent.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
